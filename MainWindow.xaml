<Window x:Class="HopeChestCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HopeChestCore" Icon="Assets/HopeChestCore.ico" Width="1190" Height="790" MinWidth="1000" MinHeight="720"
        FontFamily="Segoe UI" Language="de-DE" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#080F21" Offset="0"/>
            <GradientStop Color="#101F42" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#42E7FF"/>
        <SolidColorBrush x:Key="Violet" Color="#C193FF"/>
        <LinearGradientBrush x:Key="ActionGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#50E4FF"/>
            <GradientStop Color="#BE9AFF" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock" x:Key="MetricLabel">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricValue" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="30"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RateValue" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="Border" x:Key="MetricCard" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="181"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,25">
                        <Image Source="Assets/HopeChestCore.ico" Width="24" Height="24" Margin="0,0,8,0"/>
                        <TextBlock Text="HopeChestCore" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="REPLAY-IMPORT" Style="{StaticResource MetricLabel}" Margin="0,0,0,8"/>
                    <Button Content="Replay-Ordner" Click="ChooseFolder" HorizontalAlignment="Stretch" Margin="0,0,0,7"/>
                    <Button x:Name="ScanButton" Content="Jetzt prüfen" Click="ScanNow" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="STATISTIK" Style="{StaticResource MetricLabel}" Margin="0,26,0,8"/>
                    <Button x:Name="ResetButton" Content="Statistik zurücksetzen" Click="ResetStatistics" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Statistik zurücksetzen"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Background="#0C1732" Padding="9">
                    <StackPanel>
                        <TextBlock Text="IMPORTSTATUS" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="Status" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" FontSize="11"/>
                        <TextBlock x:Name="Folder" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,20,0,10">
                    <TextBlock DockPanel.Dock="Top" Text="ZEITRAUM" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                    <ListBox x:Name="Days" DisplayMemberPath="Label" SelectionChanged="ChangeStatisticsPeriod"
                             AutomationProperties.Name="Zeitraum" Background="Transparent" Foreground="{StaticResource Ink}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="DayRow" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent"
                                                    Background="Transparent" Padding="8,5" Margin="0,0,0,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DayRow" Property="Background" Value="#192E53"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="DayRow" Property="Background" Value="#1B365B"/>
                                                    <Setter TargetName="DayRow" Property="BorderBrush" Value="#335C85"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="15,9" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock x:Name="Period" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Truhenstatistik" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Fortnite · Battle Royale &amp; Zero Build" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-9,10">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0" BorderBrush="#2B6186"
                        ToolTip="Deine Truhen plus die im Replay erfassten Truhen deiner Teammates.">
                    <StackPanel>
                        <TextBlock Text="Truhen gesamt" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="TotalChests" Style="{StaticResource MetricValue}" Foreground="{StaticResource Cyan}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0" BorderBrush="#534183"
                        ToolTip="Deine geöffneten und zerstörten Truhen.">
                    <StackPanel>
                        <TextBlock Text="Eigene Truhen" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="OwnChests" Style="{StaticResource MetricValue}" Foreground="{StaticResource Violet}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0" ToolTip="Truhen deiner Teammates, soweit sie im Replay erfasst wurden.">
                    <StackPanel>
                        <TextBlock Text="Teammate-Truhen" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="Squad" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Erfasste Matches" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="Matches" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Grid.Row="2" Margin="3,0,3,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="ChartRange" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <RadioButton GroupName="ChartMetric" IsChecked="True" Content="Truhen / Match" Click="ChangeChartMetric" Margin="0,0,12,0"/>
                    <RadioButton x:Name="ShowMinuteCharts" GroupName="ChartMetric" Content="Truhen / Minute" Click="ChangeChartMetric"/>
                </StackPanel>
                <TextBlock Text="Verläufe" FontSize="15" FontWeight="SemiBold"/>
            </DockPanel>

            <UniformGrid Grid.Row="3" Columns="2" Margin="0,0,-10,10">
                <Border Style="{StaticResource Card}" Padding="12,10,12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Truhen gesamt" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Cyan}"/>
                        <UniformGrid Columns="2" Margin="0,7,0,8">
                            <StackPanel>
                                <TextBlock Text="Ø Truhen / Match" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TotalPerMatch" Style="{StaticResource RateValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Ø Truhen / Min." Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="TotalPerMinute" Style="{StaticResource RateValue}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Grid Height="111">
                            <Canvas x:Name="TotalChart" SizeChanged="ChartResized" ClipToBounds="True"
                                    AutomationProperties.Name="Verlauf der Gesamttruhen"/>
                            <TextBlock x:Name="TotalChartEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12,10,12,7" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Eigene Truhen" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Violet}"/>
                        <UniformGrid Columns="2" Margin="0,7,0,8">
                            <StackPanel>
                                <TextBlock Text="Ø Truhen / Match" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="OwnPerMatch" Style="{StaticResource RateValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Ø Truhen / Min." Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="OwnPerMinute" Style="{StaticResource RateValue}"/>
                            </StackPanel>
                        </UniformGrid>
                        <Grid Height="111">
                            <Canvas x:Name="OwnChart" SizeChanged="ChartResized" ClipToBounds="True"
                                    AutomationProperties.Name="Verlauf der eigenen Truhen"/>
                            <TextBlock x:Name="OwnChartEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="13,8">
                        <TextBlock x:Name="DurationHint" DockPanel.Dock="Right" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                        <TextBlock Text="Match-Verlauf" FontSize="15" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Grid>
                        <ListView x:Name="History" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#12294D"/>
                                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                    <Setter Property="Padding" Value="5,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="ToolTip" Value="{Binding ReplayFile}"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Matchzeit" Width="124" DisplayMemberBinding="{Binding PlayedAt, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                    <GridViewColumn Header="Spieler" Width="108" DisplayMemberBinding="{Binding Player}"/>
                                    <GridViewColumn Header="Modus" Width="89" DisplayMemberBinding="{Binding Mode}"/>
                                    <GridViewColumn Header="Gesamt" Width="60" DisplayMemberBinding="{Binding TotalChests, StringFormat=N0}"/>
                                    <GridViewColumn Header="Eigene" Width="54" DisplayMemberBinding="{Binding OwnChests, StringFormat=N0}"/>
                                    <GridViewColumn Header="Teammates" Width="75" DisplayMemberBinding="{Binding Squad, StringFormat=N0}"/>
                                    <GridViewColumn Header="Dauer" Width="58" DisplayMemberBinding="{Binding DurationLabel}"/>
                                    <GridViewColumn Header="Ges. / Min." Width="76" DisplayMemberBinding="{Binding TotalPerMinute, StringFormat=N2, TargetNullValue=–}"/>
                                    <GridViewColumn Header="Eig. / Min." Width="76" DisplayMemberBinding="{Binding OwnPerMinute, StringFormat=N2, TargetNullValue=–}"/>
                                    <GridViewColumn Header="Hinweis" Width="168" DisplayMemberBinding="{Binding Note}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Keine Matches in diesem Zeitraum." Foreground="{StaticResource Muted}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <Expander Grid.Row="5" x:Name="IssuePanel" Foreground="{StaticResource Ink}" Visibility="Collapsed" Margin="0,6,0,0">
                <ListBox x:Name="Issues" MaxHeight="50" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"/>
            </Expander>
        </Grid>
    </Grid>
</Window>
