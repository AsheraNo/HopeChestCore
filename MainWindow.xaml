<Window x:Class="HopeChestCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HopeChestCore" Icon="Assets/HopeChestCore.ico" Width="1320" Height="820" MinWidth="1080" MinHeight="720"
        FontFamily="Segoe UI" Language="de-DE" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#191831" Offset="0"/>
            <GradientStop Color="#34335E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="Periwinkle" Color="#AFA7FF"/>
        <SolidColorBrush x:Key="Rose" Color="#F6AADC"/>
        <SolidColorBrush x:Key="Gold" Color="#FFD991"/>
        <LinearGradientBrush x:Key="LeadMetric" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5550A1"/>
            <GradientStop Color="#39376F" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock" x:Key="MetricLabel">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricValue" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="30"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RateValue" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="Border" x:Key="MetricCard" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Toggle" CornerRadius="7" Padding="9,5" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Toggle" Property="Background" Value="#38365F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Toggle" Property="Background" Value="#4B457C"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Focus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="10" Background="#242344">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,25">
                        <Image Source="Assets/HopeChestCore.ico" Width="24" Height="24" Margin="0,0,8,0"/>
                        <TextBlock Text="HopeChestCore" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="REPLAY-IMPORT" Style="{StaticResource MetricLabel}" Margin="0,0,0,8"/>
                    <Button Content="Replay-Ordner" Click="ChooseFolder" HorizontalAlignment="Stretch" Margin="0,0,0,7"/>
                    <Button x:Name="ScanButton" Content="Jetzt prüfen" Click="ScanNow" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="STATISTIK" Style="{StaticResource MetricLabel}" Margin="0,26,0,8"/>
                    <Button x:Name="ResetButton" Content="Statistik zurücksetzen" Click="ResetStatistics" HorizontalAlignment="Stretch" Padding="5,8"
                            AutomationProperties.Name="Statistik zurücksetzen"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Background="#201E3A" Padding="9">
                    <StackPanel>
                        <TextBlock Text="IMPORTSTATUS" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="Status" Foreground="{StaticResource Periwinkle}" TextWrapping="Wrap" FontSize="11"/>
                        <TextBlock x:Name="Folder" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <DockPanel Margin="0,20,0,10">
                    <TextBlock DockPanel.Dock="Top" Text="ZEITRAUM" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
                    <ListBox x:Name="Days" DisplayMemberPath="Label" SelectionChanged="ChangeStatisticsPeriod"
                             AutomationProperties.Name="Zeitraum" Background="Transparent" Foreground="{StaticResource Ink}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="DayRow" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent"
                                                    Background="Transparent" Padding="8,5" Margin="0,0,0,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DayRow" Property="Background" Value="#38365F"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="DayRow" Property="Background" Value="#474279"/>
                                                    <Setter TargetName="DayRow" Property="BorderBrush" Value="#68609F"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Periwinkle}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="236"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.3*" MinHeight="235"/>
                <RowDefinition Height="*" MinHeight="132"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.ColumnSpan="2" Padding="2,1,2,3" Margin="0,0,0,14">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#302D56" CornerRadius="9" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock x:Name="Period"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Truhenstatistik" FontSize="27" FontWeight="SemiBold"/>
                        <TextBlock Text="Fortnite · Battle Royale &amp; Zero Build" Style="{StaticResource MetricLabel}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,3,12">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0" BorderBrush="#6A64B2" Background="{StaticResource LeadMetric}"
                        ToolTip="Deine Truhen plus die im Replay erfassten Truhen deiner Teammates.">
                    <StackPanel>
                        <TextBlock Text="Truhen gesamt" Style="{StaticResource MetricLabel}" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="TotalChests" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0" BorderBrush="#514773"
                        ToolTip="Deine geöffneten und zerstörten Truhen.">
                    <StackPanel>
                        <TextBlock Text="Eigene Truhen" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="OwnChests" Style="{StaticResource MetricValue}" Foreground="{StaticResource Rose}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0" ToolTip="Truhen deiner Teammates, soweit sie im Replay erfasst wurden.">
                    <StackPanel>
                        <TextBlock Text="Teammate-Truhen" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="Squad" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="Erfasste Matches" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="Matches" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="ChartMetric" IsChecked="True" Content="Truhen / Match" Click="ChangeChartMetric" Margin="0,0,3,0"/>
                            <RadioButton x:Name="ShowMinuteCharts" GroupName="ChartMetric" Content="Truhen / Minute" Click="ChangeChartMetric"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Truhenverlauf" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChartRange" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,7,0,0">
                        <StackPanel>
                            <TextBlock Text="●  Truhen gesamt" Foreground="{StaticResource Periwinkle}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource MetricLabel}" Margin="0,2,0,0"><Run Text="Ø "/><Run x:Name="TotalPerMatch"/><Run Text=" / Match  ·  "/><Run x:Name="TotalPerMinute"/><Run Text=" / Min."/></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="●  Eigene Truhen" Foreground="{StaticResource Rose}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource MetricLabel}" Margin="0,2,0,0"><Run Text="Ø "/><Run x:Name="OwnPerMatch"/><Run Text=" / Match  ·  "/><Run x:Name="OwnPerMinute"/><Run Text=" / Min."/></TextBlock>
                        </StackPanel>
                    </UniformGrid>
                    <Grid>
                        <Canvas x:Name="ChestChart" SizeChanged="ChartResized" ClipToBounds="True"
                                AutomationProperties.Name="Verlauf der gesamten und eigenen Truhen"/>
                        <TextBlock x:Name="ChartEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Drop-Chancen" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Chance auf mindestens einen Treffer" Style="{StaticResource MetricLabel}" TextWrapping="Wrap" Margin="0,4,0,3"/>
                    <TextBlock x:Name="ChanceChestCount" Style="{StaticResource MetricLabel}" Margin="0,0,0,12"
                               ToolTip="Deine geöffneten und zerstörten Truhen plus die im Replay erfassten Teamtruhen."/>
                    <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8" Background="#393359" BorderBrush="#585073">
                        <StackPanel>
                            <TextBlock Text="Wöchentliches Goldenes Outfit" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OutfitChance" Style="{StaticResource RateValue}" Foreground="{StaticResource Gold}"/>
                            <TextBlock x:Name="OutfitBaseOdds" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="10,8" Background="#383463" BorderBrush="#544F81">
                        <StackPanel>
                            <TextBlock Text="Zugang zum Piratenshop" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PirateShopChance" Style="{StaticResource RateValue}" Foreground="{StaticResource Periwinkle}"/>
                            <TextBlock x:Name="PirateShopBaseOdds" Style="{StaticResource MetricLabel}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Schätzung mit festen Basisquoten. Event-Boni und Loot-Zeiträume sind nicht eingerechnet."
                               Style="{StaticResource MetricLabel}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="0,0,0,7" ClipToBounds="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="13,8">
                        <TextBlock x:Name="DurationHint" DockPanel.Dock="Right" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                        <TextBlock Text="Match-Verlauf" FontSize="15" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Grid>
                        <ListView x:Name="History" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#32305B"/>
                                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                    <Setter Property="Padding" Value="5,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                    <Setter Property="Padding" Value="0,4"/>
                                    <Setter Property="ToolTip" Value="{Binding ReplayFile}"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Matchzeit" Width="124" DisplayMemberBinding="{Binding PlayedAt, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                    <GridViewColumn Header="Spieler" Width="108" DisplayMemberBinding="{Binding Player}"/>
                                    <GridViewColumn Header="Modus" Width="89" DisplayMemberBinding="{Binding Mode}"/>
                                    <GridViewColumn Header="Gesamt" Width="60" DisplayMemberBinding="{Binding TotalChests, StringFormat=N0}"/>
                                    <GridViewColumn Header="Eigene" Width="54" DisplayMemberBinding="{Binding OwnChests, StringFormat=N0}"/>
                                    <GridViewColumn Header="Teammates" Width="75" DisplayMemberBinding="{Binding Squad, StringFormat=N0}"/>
                                    <GridViewColumn Header="Dauer" Width="58" DisplayMemberBinding="{Binding DurationLabel}"/>
                                    <GridViewColumn Header="Ges. / Min." Width="76" DisplayMemberBinding="{Binding TotalPerMinute, StringFormat=N2, TargetNullValue=–}"/>
                                    <GridViewColumn Header="Eig. / Min." Width="76" DisplayMemberBinding="{Binding OwnPerMinute, StringFormat=N2, TargetNullValue=–}"/>
                                    <GridViewColumn Header="Hinweis" Width="168" DisplayMemberBinding="{Binding Note}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Keine Matches in diesem Zeitraum." Foreground="{StaticResource Muted}"/>
                    </Grid>
                </DockPanel>
            </Border>
            <Expander Grid.Row="4" Grid.ColumnSpan="2" x:Name="IssuePanel" Foreground="{StaticResource Ink}" Visibility="Collapsed" Margin="0,6,0,0">
                <ListBox x:Name="Issues" MaxHeight="50" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"/>
            </Expander>
        </Grid>
    </Grid>
</Window>
